# Git ignore for Open Hardware Pizza Oven Project

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# CAD & 3D Temporary / Auto-save files
*.bak
*.bk[0-9]
*.autosave
*.tmp
*.log
*.err
*.$$$
*.dwl
*.dwl2
*.swp
*.swn
*~
~$*
*.FCBak
*.FCStd#
*.step.bak
*.stp.bak
*.dxf.bak

# FreeCAD / Solvespace / OpenSCAD temporary exports
cad/exports/*.tmp
cad/exports/*_temp.*

# Regenerated STEP/STL from `python3 -m cad.build`. Do not commit.
cad/output/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# Repo-root setuptools directory only. An unanchored `parts/` rule also
# ignored `cad/parts/`, which is parametric CAD source and must be tracked.
/parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / JS artifacts (for anatomy / viewer web apps)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.cache/

# Local configuration & secrets
.env
.env.local
local_settings.py
